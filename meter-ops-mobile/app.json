{
  "expo": {
    "name": "MeterOps Mobile",
    "slug": "meter-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meter-ops-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b132b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meterops.app"
    },
    "android": {
      "package": "com.meterops.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eff37029-bf46-471a-96a6-6ce012bdca2d"
      }
    },
    "owner": "chandan_321"
  }
}
