{
  "expo": {
    "name": "MeterOps Mobile",
    "slug": "meter-ops-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meter-ops-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f5f4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meterops.app"
    },
    "android": {
      "package": "com.meterops.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6c4fd55-1d97-4a20-922d-752486528dea"
      }
    },
    "owner": "chandan_321"
  }
}
